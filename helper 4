Sub SendChartsIn2ColumnGrid()

    Dim OutApp As Object
    Dim OutMail As Object
    Dim wdDoc As Object
    Dim wdRange As Object
    
    Dim ws As Worksheet
    Dim totalCharts As Long
    Dim i As Long
    Dim rowIndex As Long
    Dim colIndex As Long
    Dim tbl As Object
    
    '==== CHANGE SHEET NAME ====
    Set ws = ThisWorkbook.Worksheets("Sheet1")
    
    totalCharts = ws.ChartObjects.Count
    
    If totalCharts = 0 Then
        MsgBox "No charts found on sheet!"
        Exit Sub
    End If
    
    ' Create Outlook
    Set OutApp = CreateObject("Outlook.Application")
    Set OutMail = OutApp.CreateItem(0)
    
    With OutMail
        .Subject = "Charts Report"
        .Display
    End With
    
    ' Get Word Editor
    Set wdDoc = OutMail.GetInspector.WordEditor
    Set wdRange = wdDoc.Range(0, 0)
    
    ' Calculate rows needed (2 charts per row)
    Dim totalRows As Long
    totalRows = (totalCharts + 1) \ 2
    
    ' Insert table
    Set tbl = wdDoc.Tables.Add(wdRange, totalRows, 2)
    
    ' Set table width to 100%
    tbl.PreferredWidthType = 1
    tbl.PreferredWidth = 100
    
    ' Set each column to 50%
    tbl.Columns(1).PreferredWidthType = 1
    tbl.Columns(1).PreferredWidth = 50
    
    tbl.Columns(2).PreferredWidthType = 1
    tbl.Columns(2).PreferredWidth = 50
    
    ' Loop charts
    i = 1
    
    For rowIndex = 1 To totalRows
        For colIndex = 1 To 2
            
            If i <= totalCharts Then
                
                ' Copy chart as picture
                ws.ChartObjects(i).Chart.CopyPicture _
                    Appearance:=xlScreen, _
                    Format:=xlPicture
                
                ' Paste inside cell
                tbl.Cell(rowIndex, colIndex).Range.Paste
                
                i = i + 1
            End If
            
        Next colIndex
    Next rowIndex
    
    MsgBox "Charts inserted successfully in 2-column layout!"

End Sub
