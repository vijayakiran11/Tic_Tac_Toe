import win32com.client as win32
import os

# ================== CONFIG ==================
EXCEL_FILE_NAME = "DJ.xlsm"        # MUST already be open
SHEET_NAME = "Sheet2"

TEMP_DIR = r"C:\Temp\charts"

EMAIL_TO = "someone@example.com"
EMAIL_SUBJECT = "Charts Dashboard"

# YOU CONTROL THIS: charts per table (stacked vertically)
TABLE_CHART_COUNTS = [4, 5, 5, 22]
# ============================================

os.makedirs(TEMP_DIR, exist_ok=True)

# ================== STEP 1: CONNECT TO OPEN EXCEL ==================
excel = win32.GetActiveObject("Excel.Application")
wb = excel.Workbooks(EXCEL_FILE_NAME)
ws = wb.Sheets(SHEET_NAME)

# ---- Collect charts with visual position ----
charts = []
for chart_obj in ws.ChartObjects():
    charts.append({
        "chart": chart_obj,
        "top": chart_obj.Top,
        "left": chart_obj.Left
    })

# ---- Sort charts exactly as they appear in Excel ----
charts.sort(key=lambda c: (c["top"], c["left"]))

# ---- Export charts in visual order ----
chart_paths = []
for i, c in enumerate(charts, start=1):
    img_path = os.path.join(TEMP_DIR, f"chart_{i}.png")
    c["chart"].Chart.Export(img_path)
    chart_paths.append(img_path)

# ================== STEP 2: BUILD HTML TABLES ==================
html_tables = ""
idx = 0

for table_no, chart_count in enumerate(TABLE_CHART_COUNTS, start=1):
    table_imgs = chart_paths[idx: idx + chart_count]
    idx += chart_count

    if not table_imgs:
        break

    html_tables += f"<h3>Section {table_no}</h3>"
    html_tables += '<table border="0" cellspacing="12" cellpadding="0">'

    for i, img_path in enumerate(table_imgs):
        if i % 2 == 0:
            html_tables += "<tr>"

        img_html_path = img_path.replace("\\", "/")
        html_tables += f"""
            <td>
                <img src="file:///{img_html_path}" style="display:block;">
            </td>
        """

        if i % 2 == 1:
            html_tables += "</tr>"

    # Close last row if odd number of charts
    if len(table_imgs) % 2 == 1:
        html_tables += "</tr>"

    html_tables += "</table><br><br>"

# ================== STEP 3: SEND VIA OUTLOOK ==================
outlook = win32.Dispatch("Outlook.Application")
mail = outlook.CreateItem(0)

mail.To = EMAIL_TO
mail.Subject = EMAIL_SUBJECT

mail.HTMLBody = f"""
<html>
<body>
<h2>Charts Dashboard</h2>
{html_tables}
</body>
</html>
"""

mail.Display()   # change to .Send when ready

# ================== CLEANUP ==================
del ws
del wb
del excel
