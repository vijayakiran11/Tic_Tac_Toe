Sub SendChartsInGrid()

    Dim OutApp As Object
    Dim OutMail As Object
    Dim ws As Worksheet
    Dim chtObj As ChartObject
    Dim i As Long
    Dim totalCharts As Long
    Dim totalRows As Long
    Dim htmlBody As String
    Dim chartIndex As Long
    
    '==== CHANGE SHEET NAME HERE ====
    Set ws = ThisWorkbook.Worksheets("Sheet1")
    
    totalCharts = ws.ChartObjects.Count
    
    If totalCharts = 0 Then
        MsgBox "No charts found!"
        Exit Sub
    End If
    
    ' Calculate required rows (2 charts per row)
    totalRows = (totalCharts + 1) \ 2
    
    ' Create Outlook
    Set OutApp = CreateObject("Outlook.Application")
    Set OutMail = OutApp.CreateItem(0)
    
    ' Start HTML table
    htmlBody = "<html><body>"
    htmlBody = htmlBody & "<table style='width:100%; border-collapse:collapse;'>"
    
    chartIndex = 1
    
    For i = 1 To totalRows
        htmlBody = htmlBody & "<tr>"
        
        ' ===== LEFT COLUMN =====
        If chartIndex <= totalCharts Then
            ws.ChartObjects(chartIndex).Chart.CopyPicture Appearance:=xlScreen, Format:=xlPicture
            
            htmlBody = htmlBody & "<td style='width:50%; padding:5px;' id='chart" & chartIndex & "'></td>"
            chartIndex = chartIndex + 1
        Else
            htmlBody = htmlBody & "<td style='width:50%;'></td>"
        End If
        
        ' ===== RIGHT COLUMN =====
        If chartIndex <= totalCharts Then
            ws.ChartObjects(chartIndex).Chart.CopyPicture Appearance:=xlScreen, Format:=xlPicture
            
            htmlBody = htmlBody & "<td style='width:50%; padding:5px;' id='chart" & chartIndex & "'></td>"
            chartIndex = chartIndex + 1
        Else
            htmlBody = htmlBody & "<td style='width:50%;'></td>"
        End If
        
        htmlBody = htmlBody & "</tr>"
    Next i
    
    htmlBody = htmlBody & "</table></body></html>"
    
    ' Set basic mail properties
    With OutMail
        .Subject = "Charts Report"
        .HTMLBody = htmlBody
        .Display
    End With
    
    ' Paste charts after display
    chartIndex = 1
    
    For Each chtObj In ws.ChartObjects
        chtObj.Chart.CopyPicture Appearance:=xlScreen, Format:=xlPicture
        
        With OutMail.GetInspector.WordEditor
            .Application.Selection.Find.ClearFormatting
            .Application.Selection.Find.Text = "chart" & chartIndex
            .Application.Selection.Find.Execute
            
            If .Application.Selection.Find.Found Then
                .Application.Selection.Paste
            End If
        End With
        
        chartIndex = chartIndex + 1
    Next chtObj
    
    MsgBox "Charts inserted in 2-column grid successfully!"

End Sub
