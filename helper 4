
import os
import time
import tempfile
import win32com.client  # pywin32

# ─────────────────────────── CONFIG ───────────────────────────
EXCEL_FILE    = r"C:\Path\To\Your\Workbook.xlsx"   # Set to "" to use an already-open workbook
SHEET_NAME    = "Charts"                           # Sheet that contains the charts

EMAIL_TO      = "recipient@example.com"
EMAIL_CC      = ""                                 # Leave "" if not needed
EMAIL_SUBJECT = "Charts Report"
EMAIL_INTRO   = "Hi,<br><br>Please find the charts below.<br><br>"
EMAIL_FOOTER  = "<br><br>Regards,<br>Your Name"

# Image export settings — larger = clearer for recipients
CHART_WIDTH_PX  = 700    # px width each chart cell in the email table
CHART_HEIGHT_PX = 450    # px height

# Excel export DPI (higher = crisper image, larger file)
EXPORT_DPI = 150         # 96 = screen, 150 = good balance, 300 = print quality
# ──────────────────────────────────────────────────────────────


def get_excel_app_and_workbook():
    """Return (xlApp, wb). Opens file if EXCEL_FILE is set, else attaches to running Excel."""
    xl = win32com.client.gencache.EnsureDispatch("Excel.Application")
    xl.Visible = True

    if EXCEL_FILE:
        # Check if already open
        wb = None
        fname = os.path.basename(EXCEL_FILE).lower()
        for w in xl.Workbooks:
            if w.Name.lower() == fname:
                wb = w
                break
        if wb is None:
            wb = xl.Workbooks.Open(EXCEL_FILE)
    else:
        # Use the active workbook
        wb = xl.ActiveWorkbook
        if wb is None:
            raise RuntimeError("No workbook is open in Excel. Set EXCEL_FILE or open one first.")

    return xl, wb


def export_charts_as_images(wb, sheet_name, tmp_dir):
    """
    Copy each chart on the sheet to clipboard then export as PNG.
    Returns list of image file paths in chart order.
    """
    try:
        ws = wb.Sheets(sheet_name)
    except Exception:
        raise ValueError(f"Sheet '{sheet_name}' not found in workbook '{wb.Name}'.")

    chart_objects = ws.ChartObjects()
    count = chart_objects.Count
    if count == 0:
        raise RuntimeError(f"No charts found on sheet '{sheet_name}'.")

    print(f"Found {count} chart(s) on sheet '{sheet_name}'. Exporting…")

    image_paths = []
    for i in range(1, count + 1):
        co = chart_objects(i)
        chart = co.Chart

        # Export directly to PNG
        img_path = os.path.join(tmp_dir, f"chart_{i:02d}.png")
        # ExportChart: Filename, FilterName, Interactive
        chart.Export(img_path, "PNG")
        image_paths.append(img_path)
        print(f"  Exported chart {i}: {img_path}")

    return image_paths


def build_html_table(cid_list):
    """
    Build an HTML table (2 columns) embedding charts via CID references.
    Each cell is fixed-width so charts never get squeezed.
    """
    col_width = CHART_WIDTH_PX + 20  # padding

    rows_html = []
    for i in range(0, len(cid_list), 2):
        left_cid  = cid_list[i]
        right_cid = cid_list[i + 1] if i + 1 < len(cid_list) else None

        left_cell = (
            f'<td style="padding:10px;vertical-align:top;width:{col_width}px;">'
            f'<img src="cid:{left_cid}" width="{CHART_WIDTH_PX}" height="{CHART_HEIGHT_PX}" '
            f'style="display:block;border:1px solid #ddd;" /></td>'
        )

        if right_cid:
            right_cell = (
                f'<td style="padding:10px;vertical-align:top;width:{col_width}px;">'
                f'<img src="cid:{right_cid}" width="{CHART_WIDTH_PX}" height="{CHART_HEIGHT_PX}" '
                f'style="display:block;border:1px solid #ddd;" /></td>'
            )
        else:
            right_cell = f'<td style="width:{col_width}px;"></td>'

        rows_html.append(f"<tr>{left_cell}{right_cell}</tr>")

    table = (
        f'<table border="0" cellspacing="0" cellpadding="0" '
        f'style="border-collapse:collapse;">'
        + "".join(rows_html)
        + "</table>"
    )
    return table


def send_outlook_email(image_paths):
    """Create an Outlook MailItem with charts embedded inline in a 2-column table."""
    outlook = win32com.client.Dispatch("Outlook.Application")
    mail = outlook.CreateItem(0)  # 0 = olMailItem

    mail.To      = EMAIL_TO
    mail.CC      = EMAIL_CC
    mail.Subject = EMAIL_SUBJECT

    # Attach each image and collect Content-IDs
    cid_list = []
    for idx, img_path in enumerate(image_paths):
        attachment = mail.Attachments.Add(img_path)
        # Set PR_ATTACH_CONTENT_ID (MAPI property 0x3712001E)
        cid = f"chart{idx:02d}@report"
        attachment.PropertyAccessor.SetProperty(
            "http://schemas.microsoft.com/mapi/proptag/0x3712001E", cid
        )
        cid_list.append(cid)

    table_html = build_html_table(cid_list)

    mail.HTMLBody = (
        "<html><body style='font-family:Calibri,Arial,sans-serif;font-size:14px;'>"
        + EMAIL_INTRO
        + table_html
        + EMAIL_FOOTER
        + "</body></html>"
    )

    mail.Display()   # Opens draft for review — use mail.Send() to send immediately
    print("Outlook draft opened. Review and send.")


def main():
    tmp_dir = tempfile.mkdtemp(prefix="xl_charts_")
    print(f"Temp folder: {tmp_dir}")

    xl, wb = get_excel_app_and_workbook()
    image_paths = export_charts_as_images(wb, SHEET_NAME, tmp_dir)
    send_outlook_email(image_paths)

    # Optionally close workbook if we opened it
    # wb.Close(False)

    print("Done!")


if __name__ == "__main__":
    main()
