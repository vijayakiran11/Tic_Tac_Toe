Sub Paste_All_Charts_To_Outlook_FLOATING_BIG_ALIGNED()

    Dim srcWs As Worksheet
    Dim ch As ChartObject
    Dim olApp As Object
    Dim olMail As Object
    Dim wdDoc As Object
    Dim shp As Object

    Dim chartCount As Long
    Dim leftPos As Double, topPos As Double
    Dim usableWidth As Double
    Dim chartWidth As Double
    Dim gap As Double

    Dim firstShapeInRow As Object
    Dim maxRowHeight As Double

    ' ===== CHANGE SHEET NAME IF NEEDED =====
    Set srcWs = Worksheets("Charts")
    ' =====================================

    gap = 20

    ' Start Outlook
    Set olApp = CreateObject("Outlook.Application")
    Set olMail = olApp.CreateItem(0)
    olMail.BodyFormat = 2
    olMail.Display

    Set wdDoc = olMail.GetInspector.WordEditor

    ' Calculate usable email width
    usableWidth = wdDoc.PageSetup.PageWidth _
                  - wdDoc.PageSetup.LeftMargin _
                  - wdDoc.PageSetup.RightMargin

    chartWidth = (usableWidth / 2) - gap

    leftPos = wdDoc.PageSetup.LeftMargin
    topPos = wdDoc.PageSetup.TopMargin
    chartCount = 0

    For Each ch In srcWs.ChartObjects

        chartCount = chartCount + 1

        ' Copy as HIGH-RES picture
        ch.Chart.CopyPicture Appearance:=xlPrinter, Format:=xlPicture

        ' Paste
        wdDoc.Range(wdDoc.Content.End - 1).Paste
        Set shp = wdDoc.Shapes(wdDoc.Shapes.Count)

        With shp
            .WrapFormat.Type = 3   ' wdWrapSquare (FLOATING)
            .LockAspectRatio = True
            .Width = chartWidth
        End With

        ' ---- FIRST CHART IN ROW ----
        If chartCount Mod 2 = 1 Then

            shp.Left = leftPos
            shp.Top = topPos

            Set firstShapeInRow = shp
            maxRowHeight = shp.Height

        ' ---- SECOND CHART IN ROW ----
        Else

            shp.Left = leftPos + chartWidth + gap
            shp.Top = topPos

            ' Find max height of the row
            If shp.Height > maxRowHeight Then
                maxRowHeight = shp.Height
            End If

            ' FORCE BOTH CHARTS TO SAME HEIGHT
            firstShapeInRow.Height = maxRowHeight
            shp.Height = maxRowHeight

            ' Move to next row
            topPos = topPos + maxRowHeight + gap

        End If

    Next ch

    MsgBox "Charts pasted BIG and perfectly aligned.", vbInformation

End Sub



