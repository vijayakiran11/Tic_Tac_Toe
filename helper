Sub Insert_Working_Dates_Till_Today()

    Dim ws As Worksheet
    Dim tbl As ListObject
    Dim lastDateSerial As Long
    Dim newDateSerial As Long
    Dim endDateSerial As Long
    Dim holidayDict As Object
    Dim c As Range
    Dim newRow As ListRow
    Dim lastRowIndex As Long

    Set ws = ActiveSheet

    ' 🔒 Build holiday lookup ONCE (DATE SERIALS ONLY)
    Set holidayDict = CreateObject("Scripting.Dictionary")
    For Each c In Range("UK_HOLIDAYS").Cells
        holidayDict(CLng(c.Value)) = True
    Next c

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    ' 🔁 LOOP THROUGH ALL TABLES
    For Each tbl In ws.ListObjects

        ' Skip empty tables
        If tbl.ListRows.Count = 0 Then GoTo NextTable

        lastRowIndex = tbl.ListRows.Count
        lastDateSerial = CLng(tbl.DataBodyRange(lastRowIndex, 1).Value)

        newDateSerial = lastDateSerial + 1
        endDateSerial = CLng(Date - 1)

        Do While newDateSerial <= endDateSerial

            ' Weekday check
            If Weekday(newDateSerial, vbMonday) <= 5 Then

                ' Holiday check (BULLETPROOF)
                If Not holidayDict.Exists(newDateSerial) Then

                    Set newRow = tbl.ListRows.Add

                    ' Date column (value only)
                    newRow.Range(1, 1).Value = newDateSerial

                    ' Copy formulas to other columns
                    newRow.Range(1, 2).Resize(1, tbl.ListColumns.Count - 1).Formula = _
                        tbl.DataBodyRange(lastRowIndex, 2).Resize(1, tbl.ListColumns.Count - 1).Formula

                    lastRowIndex = tbl.ListRows.Count

                End If
            End If

            newDateSerial = newDateSerial + 1
        Loop

NextTable:
    Next tbl

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "Done. All tables updated. Holidays excluded.", vbInformation

End Sub
Sub Paste_Charts_To_Outlook_Body_No_Overlap()

    Dim srcWs As Worksheet
    Dim ch As ChartObject

    Dim olApp As Object
    Dim olMail As Object
    Dim wdDoc As Object
    Dim wdTable As Object

    Dim chartCount As Long
    Dim rowIndex As Long

    Set srcWs = ActiveSheet

    ' Open Outlook
    Set olApp = CreateObject("Outlook.Application")
    Set olMail = olApp.CreateItem(0)
    olMail.Display   ' MUST display to access WordEditor

    Set wdDoc = olMail.GetInspector.WordEditor

    chartCount = 0
    rowIndex = 1

    ' Create a table with 2 columns, start with 1 row
    Set wdTable = wdDoc.Tables.Add( _
        Range:=wdDoc.Range(0, 0), _
        NumRows:=1, _
        NumColumns:=2)

    ' Formatting the table (IMPORTANT)
    wdTable.AllowAutoFit = True
    wdTable.Rows.Alignment = 1 ' Center
    wdTable.Borders.Enable = False

    For Each ch In srcWs.ChartObjects

        chartCount = chartCount + 1

        ' Copy chart as picture (preserves colours)
        ch.Chart.CopyPicture Appearance:=xlScreen, Format:=xlPicture

        ' Determine column (1 or 2)
        Dim colIndex As Long
        If chartCount Mod 2 = 1 Then
            colIndex = 1
        Else
            colIndex = 2
        End If

        ' Paste into table cell
        wdTable.Cell(rowIndex, colIndex).Range.Paste

        ' Center align inside cell
        wdTable.Cell(rowIndex, colIndex).Range.ParagraphFormat.Alignment = 1

        ' After filling 2 columns, add new row
        If colIndex = 2 Then
            wdTable.Rows.Add
            rowIndex = rowIndex + 1
        End If

    Next ch

    MsgBox "Charts pasted into Outlook email body with perfect alignment.", vbInformation

End Sub











