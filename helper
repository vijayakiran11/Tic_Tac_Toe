Sub Paste_All_Charts_To_Outlook()

    Dim srcWs As Worksheet
    Dim ch As ChartObject
    Dim olApp As Object
    Dim olMail As Object
    Dim wdDoc As Object
    Dim wdTable As Object
    Dim insertRange As Object
    Dim chartCount As Long
    Dim shp As Object
    Dim rowNum As Long, colNum As Long

    ' ===== CHANGE SHEET NAME IF NEEDED =====
    Set srcWs = Worksheets("Charts")
    ' =====================================

    ' Open Outlook
    Set olApp = CreateObject("Outlook.Application")
    Set olMail = olApp.CreateItem(0)
    olMail.BodyFormat = 2   ' HTML
    olMail.Display

    Set wdDoc = olMail.GetInspector.WordEditor

    ' Insert table at end of mail
    Set insertRange = wdDoc.Range
    insertRange.Collapse 0

    Set wdTable = wdDoc.Tables.Add(insertRange, 1, 2)
    wdTable.Borders.Enable = False
    wdTable.AllowAutoFit = False

    ' Make table full width
    wdTable.PreferredWidthType = 2   ' percent
    wdTable.PreferredWidth = 100

    ' Two equal columns
    wdTable.Columns(1).PreferredWidthType = 2
    wdTable.Columns(1).PreferredWidth = 50
    wdTable.Columns(2).PreferredWidthType = 2
    wdTable.Columns(2).PreferredWidth = 50

    chartCount = 0

    ' ===== LOOP THROUGH ALL CHARTS =====
    For Each ch In srcWs.ChartObjects

        chartCount = chartCount + 1

        ' Determine row & column
        rowNum = (chartCount + 1) \ 2
        colNum = IIf(chartCount Mod 2 = 1, 1, 2)

        ' Add row when required
        If rowNum > wdTable.Rows.Count Then
            wdTable.Rows.Add
        End If

        ' Copy chart as HIGH-RES picture
        ch.Chart.CopyPicture Appearance:=xlPrinter, Format:=xlPicture

        ' Paste into table cell
        wdTable.Cell(rowNum, colNum).Range.Paste

        ' Resize pasted image to fill column width
        Set shp = wdTable.Cell(rowNum, colNum).Range.InlineShapes(1)
        With shp
            .LockAspectRatio = True
            .Width = wdTable.Columns(colNum).Width - 10
        End With

        ' Center align
        wdTable.Cell(rowNum, colNum).Range.ParagraphFormat.Alignment = 1

    Next ch

    MsgBox "All charts pasted correctly into Outlook body.", vbInformation

End Sub
