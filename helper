Sub Insert_Working_Dates_Till_Today()

    Dim ws As Worksheet
    Dim tbl As ListObject
    Dim lastDateSerial As Long
    Dim newDateSerial As Long
    Dim endDateSerial As Long
    Dim holidayDict As Object
    Dim c As Range
    Dim newRow As ListRow
    Dim lastRowIndex As Long

    Set ws = ActiveSheet

    ' 🔒 Build holiday lookup ONCE (DATE SERIALS ONLY)
    Set holidayDict = CreateObject("Scripting.Dictionary")
    For Each c In Range("UK_HOLIDAYS").Cells
        holidayDict(CLng(c.Value)) = True
    Next c

    Application.ScreenUpdating = False
    Application.EnableEvents = False

    ' 🔁 LOOP THROUGH ALL TABLES
    For Each tbl In ws.ListObjects

        ' Skip empty tables
        If tbl.ListRows.Count = 0 Then GoTo NextTable

        lastRowIndex = tbl.ListRows.Count
        lastDateSerial = CLng(tbl.DataBodyRange(lastRowIndex, 1).Value)

        newDateSerial = lastDateSerial + 1
        endDateSerial = CLng(Date - 1)

        Do While newDateSerial <= endDateSerial

            ' Weekday check
            If Weekday(newDateSerial, vbMonday) <= 5 Then

                ' Holiday check (BULLETPROOF)
                If Not holidayDict.Exists(newDateSerial) Then

                    Set newRow = tbl.ListRows.Add

                    ' Date column (value only)
                    newRow.Range(1, 1).Value = newDateSerial

                    ' Copy formulas to other columns
                    newRow.Range(1, 2).Resize(1, tbl.ListColumns.Count - 1).Formula = _
                        tbl.DataBodyRange(lastRowIndex, 2).Resize(1, tbl.ListColumns.Count - 1).Formula

                    lastRowIndex = tbl.ListRows.Count

                End If
            End If

            newDateSerial = newDateSerial + 1
        Loop

NextTable:
    Next tbl

    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox "Done. All tables updated. Holidays excluded.", vbInformation

End Sub

