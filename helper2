Sub RunSQL_And_Paste_ByHeader_FAST()

    ' ===== ONLY CHANGE THESE =====
    Const SERVER_NAME As String = "YOUR_SERVER_NAME"
    Const DATABASE_NAME As String = "YOUR_DATABASE_NAME"

    Dim SQL_QUERY As String
    SQL_QUERY = "
        SELECT
            TradeDate,
            ISIN,
            Quantity,
            Price
        FROM dbo.Trades
    "
    ' =============================

    Dim cn As Object, rs As Object
    Dim ws As Worksheet
    Dim headerMap As Object
    Dim col As Long, i As Long
    Dim lastRow As Long
    Dim dataArr As Variant
    Dim fieldCount As Long, rowCount As Long

    Application.ScreenUpdating = False
    Application.EnableEvents = False
    Application.Calculation = xlCalculationManual

    Set ws = ActiveSheet

    ' Build header map
    Set headerMap = CreateObject("Scripting.Dictionary")
    col = 1
    Do While ws.Cells(1, col).Value <> ""
        headerMap(LCase(Trim(ws.Cells(1, col).Value))) = col
        col = col + 1
    Loop

    ' Open connection
    Set cn = CreateObject("ADODB.Connection")
    cn.Open "Provider=SQLOLEDB;" & _
            "Data Source=" & SERVER_NAME & ";" & _
            "Initial Catalog=" & DATABASE_NAME & ";" & _
            "Integrated Security=SSPI;"

    Set rs = CreateObject("ADODB.Recordset")
    rs.CursorLocation = 3 ' adUseClient
    rs.Open SQL_QUERY, cn

    ' Pull ALL data at once
    dataArr = rs.GetRows
    rowCount = UBound(dataArr, 2) + 1
    fieldCount = rs.Fields.Count

    ' Find next empty row
    lastRow = ws.Cells(ws.Rows.Count, 1).End(xlUp).Row + 1

    ' Dump data to sheet FAST
    For i = 0 To fieldCount - 1
        If headerMap.Exists(LCase(rs.Fields(i).Name)) Then
            ws.Cells(lastRow, headerMap(LCase(rs.Fields(i).Name))). _
                Resize(rowCount, 1).Value = _
                Application.Transpose(Application.Index(dataArr, i + 1, 0))
        End If
    Next i

    rs.Close
    cn.Close

    Application.Calculation = xlCalculationAutomatic
    Application.EnableEvents = True
    Application.ScreenUpdating = True

    MsgBox rowCount & " rows loaded (FAST).", vbInformation

End Sub
