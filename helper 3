import win32com.client as win32
from PIL import Image
import os

# ================== CONFIG ==================
EXCEL_FILE_NAME = "DJ.xlsm"        # MUST already be open
SHEET_NAME = "Sheet2"
TEMP_DIR = r"C:\Temp\charts"
DASHBOARD_IMG = r"C:\Temp\dashboard.png"

EMAIL_TO = "someone@example.com"
EMAIL_SUBJECT = "Charts Dashboard"
# ============================================

os.makedirs(TEMP_DIR, exist_ok=True)

# ================== STEP 1: CONNECT TO OPEN EXCEL ==================
excel = win32.GetActiveObject("Excel.Application")
excel.Visible = True

wb = excel.Workbooks(EXCEL_FILE_NAME)
ws = wb.Sheets(SHEET_NAME)

chart_paths = []

for i, chart_obj in enumerate(ws.ChartObjects(), start=1):
    img_path = os.path.join(TEMP_DIR, f"chart_{i}.png")
    chart_obj.Chart.Export(img_path)
    chart_paths.append(img_path)

# ================== STEP 2: BUILD DASHBOARD (2 CHARTS PER ROW) ==================
images = [Image.open(p) for p in chart_paths]

chart_width = max(img.width for img in images)
chart_height = max(img.height for img in images)

rows = (len(images) + 1) // 2
dashboard = Image.new(
    "RGB",
    (chart_width * 2, chart_height * rows),
    "white"
)

for idx, img in enumerate(images):
    row = idx // 2
    col = idx % 2
    dashboard.paste(img, (col * chart_width, row * chart_height))

dashboard.save(DASHBOARD_IMG)

# ================== STEP 3: SEND VIA OUTLOOK ==================
outlook = win32.Dispatch("Outlook.Application")
mail = outlook.CreateItem(0)

mail.To = EMAIL_TO
mail.Subject = EMAIL_SUBJECT

mail.HTMLBody = f"""
<html>
<body>
<h2>Charts Dashboard</h2>
<img src="{DASHBOARD_IMG}" style="width:100%;">
</body>
</html>
"""

mail.Display()   # change to .Send when ready

# ================== CLEANUP (IMPORTANT) ==================
del ws
del wb
del excel


