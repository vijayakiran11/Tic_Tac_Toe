import win32com.client as win32
import os

# ================== CONFIG ==================
EXCEL_FULL_PATH = r"C:\Users\vijayakiran\OneDrive\Desktop\DJ.xlsm"
SHEET_NAME = "Sheet2"

TEMP_DIR = r"C:\Temp\charts"

EMAIL_TO = "someone@example.com"
EMAIL_SUBJECT = "Charts Dashboard"

# Charts per table (stacked vertically)
TABLE_CHART_COUNTS = [4, 5, 5, 22]
# ============================================

os.makedirs(TEMP_DIR, exist_ok=True)

# ================== STEP 1: CONNECT TO EXCEL (PATH-BASED, BULLETPROOF) ==================
excel = win32.Dispatch("Excel.Application")
excel.Visible = True

wb = None
for book in excel.Workbooks:
    if book.FullName.lower() == EXCEL_FULL_PATH.lower():
        wb = book
        break

if wb is None:
    wb = excel.Workbooks.Open(EXCEL_FULL_PATH)

ws = wb.Sheets(SHEET_NAME)

# ================== STEP 2: COLLECT & SORT CHARTS (EXACT VISUAL ORDER) ==================
charts = []
for chart_obj in ws.ChartObjects():
    charts.append({
        "chart": chart_obj,
        "top": chart_obj.Top,
        "left": chart_obj.Left
    })

# Sort exactly as seen in Excel (top → left)
charts.sort(key=lambda c: (c["top"], c["left"]))

# Export charts
chart_paths = []
for i, c in enumerate(charts, start=1):
    img_path = os.path.join(TEMP_DIR, f"chart_{i}.png")
    c["chart"].Chart.Export(img_path)
    chart_paths.append(img_path)

# ================== STEP 3: BUILD MULTIPLE HTML TABLES (OUTLOOK-SAFE) ==================
html_tables = ""
idx = 0
total_charts = len(chart_paths)

for section_no, requested_count in enumerate(TABLE_CHART_COUNTS, start=1):
    remaining = total_charts - idx
    if remaining <= 0:
        break

    take = min(requested_count, remaining)
    section_imgs = chart_paths[idx: idx + take]
    idx += take

    html_tables += f"<h3>Section {section_no}</h3>"
    html_tables += '<table border="0" cellspacing="12" cellpadding="0">'

    # Build rows explicitly (2 charts per row)
    for r in range(0, len(section_imgs), 2):
        html_tables += "<tr>"

        # First cell
        img1 = section_imgs[r].replace("\\", "/")
        html_tables += f"""
            <td>
                <img src="file:///{img1}" style="display:block;">
            </td>
        """

        # Second cell (or empty cell if odd count)
        if r + 1 < len(section_imgs):
            img2 = section_imgs[r + 1].replace("\\", "/")
            html_tables += f"""
                <td>
                    <img src="file:///{img2}" style="display:block;">
                </td>
            """
        else:
            html_tables += "<td></td>"

        html_tables += "</tr>"

    html_tables += "</table><br><br>"

# ================== STEP 4: SEND VIA OUTLOOK ==================
outlook = win32.Dispatch("Outlook.Application")
mail = outlook.CreateItem(0)

mail.To = EMAIL_TO
mail.Subject = EMAIL_SUBJECT

mail.HTMLBody = f"""
<html>
<body>
<h2>Charts Dashboard</h2>
{html_tables}
</body>
</html>
"""

mail.Display()   # change to .Send when ready

# ================== CLEANUP ==================
del ws
del wb
del excel






