Sub SendExcelRangesAsImagesWithHeadings_SELECTION()

    Dim wb As Workbook
    Dim olApp As Object
    Dim olMail As Object
    Dim wdDoc As Object
    Dim wdSel As Object

    '========== OPEN WORKBOOK ==========
    Set wb = Workbooks.Open("C:\Path\To\YourWorkbook.xlsx")

    '========== START OUTLOOK ==========
    Set olApp = CreateObject("Outlook.Application")
    Set olMail = olApp.CreateItem(0)

    With olMail
        .To = "someone@example.com"
        .Subject = "Excel Report"
        .Display
    End With

    '========== WORD EDITOR ==========
    Set wdDoc = olMail.GetInspector.WordEditor
    Set wdSel = wdDoc.Application.Selection

    wdSel.EndKey 6   ' 6 = wdStory (move to end)

    '========== SHEET 1 ==========
    Call InsertHeadingSel(wdSel, "Sheet1 – Summary")
    wb.Sheets("Sheet1").Range("A1:D10").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    '========== SHEET 2 ==========
    Call InsertHeadingSel(wdSel, "Sheet2 – Details")
    wb.Sheets("Sheet2").Range("A1:C8").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    '========== SHEET 3 ==========
    Call InsertHeadingSel(wdSel, "Sheet3 – Metrics")
    wb.Sheets("Sheet3").Range("B2:E12").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    '========== SHEET 4 ==========
    Call InsertHeadingSel(wdSel, "Sheet4 – Analysis")
    wb.Sheets("Sheet4").Range("A1:F6").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    '========== SHEET 5 ==========
    Call InsertHeadingSel(wdSel, "Sheet5 – Overview")
    wb.Sheets("Sheet5").Range("A1:D5").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    '========== SHEET 6 ==========
    Call InsertHeadingSel(wdSel, "Sheet6 – Final")
    wb.Sheets("Sheet6").Range("C1:G9").CopyPicture xlScreen, xlPicture
    wdSel.Paste
    Call AddSpacingSel(wdSel)

    wb.Close False

End Sub


'========== HEADING (SELECTION SAFE) ==========
Sub InsertHeadingSel(wdSel As Object, txt As String)

    wdSel.TypeText txt
    wdSel.Font.Bold = True
    wdSel.Font.Size = 12
    wdSel.TypeParagraph
    wdSel.Font.Bold = False

End Sub


'========== SPACING ==========
Sub AddSpacingSel(wdSel As Object)

    wdSel.TypeParagraph
    wdSel.TypeParagraph

End Sub


