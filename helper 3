import win32com.client as win32
from PIL import Image
import os

# ================== CONFIG ==================
EXCEL_FILE_NAME = "DJ.xlsm"        # MUST already be open
SHEET_NAME = "Sheet2"

TEMP_DIR = r"C:\Temp\charts"
DASHBOARD_IMG = r"C:\Temp\dashboard.png"

EMAIL_TO = "someone@example.com"
EMAIL_SUBJECT = "Charts Dashboard"

SCALE_FACTOR = 1.4   # keep image sharp, not too aggressive
TABLE_WIDTH_PX = 1000   # Outlook-friendly width
# ============================================

os.makedirs(TEMP_DIR, exist_ok=True)

# ================== STEP 1: CONNECT TO OPEN EXCEL ==================
excel = win32.GetActiveObject("Excel.Application")
wb = excel.Workbooks(EXCEL_FILE_NAME)
ws = wb.Sheets(SHEET_NAME)

chart_paths = []

for i, chart_obj in enumerate(ws.ChartObjects(), start=1):
    img_path = os.path.join(TEMP_DIR, f"chart_{i}.png")
    chart_obj.Chart.Export(img_path)
    chart_paths.append(img_path)

# ================== STEP 2: BUILD HIGH-RES DASHBOARD ==================
images = []

for p in chart_paths:
    img = Image.open(p)
    img = img.resize(
        (int(img.width * SCALE_FACTOR), int(img.height * SCALE_FACTOR)),
        Image.LANCZOS
    )
    images.append(img)

chart_width = max(img.width for img in images)
chart_height = max(img.height for img in images)

rows = (len(images) + 1) // 2
dashboard = Image.new(
    "RGB",
    (chart_width * 2, chart_height * rows),
    "white"
)

for i, img in enumerate(images):
    dashboard.paste(
        img,
        ((i % 2) * chart_width, (i // 2) * chart_height)
    )

dashboard.save(DASHBOARD_IMG, dpi=(300, 300))

# ================== STEP 3: OUTLOOK EMAIL USING TABLE (NO SHRINK, NO BLUR) ==================
outlook = win32.Dispatch("Outlook.Application")
mail = outlook.CreateItem(0)

mail.To = EMAIL_TO
mail.Subject = EMAIL_SUBJECT

mail.HTMLBody = f"""
<html>
<body>

<h2>Charts Dashboard</h2>

<table width="{TABLE_WIDTH_PX}" border="0" cellspacing="0" cellpadding="0">
<tr>
<td>
<img src="file:///{DASHBOARD_IMG.replace('\\', '/')}" style="display:block;">
</td>
</tr>
</table>

</body>
</html>
"""

mail.Display()   # manually resize table if you want before sending

# ================== CLEANUP ==================
del ws
del wb
del excel


